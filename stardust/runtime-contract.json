{
  "runtime": "vanilla-eds",
  "probedFrom": ["scripts/scripts.js", "scripts/aem.js"],
  "probedAt": "2026-11-19",
  "blockWrapperClass": "block",
  "blockWrapper": "div.<name>-wrapper around div.<name>.block[data-block-name]; section gains .<name>-container",
  "buttonClasses": ".button / .button.primary / .button.secondary / .button.accent, in p.button-wrapper",
  "buttonization": "formatted-only",
  "fragmentScriptPolicy": "inert-innerHTML",
  "emptySectionCollapse": true,
  "templateClass": "metadata template/theme -> body classes (decorateTemplateAndTheme)",
  "autoBlocks": "fragments (/fragments/ links) + stock widget auto-blocks",
  "headerReservation": "header { height: var(--nav-height) } + header .header visibility gate (stock)",
  "fonts": "styles/fonts.css via loadFonts() (eager >= 900px or session flag, always in loadLazy)",
  "martech": "scripts/martech.js loadConsent() in loadEager (scaffold, all parts disabled)"
}
